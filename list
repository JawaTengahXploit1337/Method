#!/bin/bash
# Domain Checker Tools by NewusBiznetSrv2
# Scan Apache & Nginx configs, list domains, roots, conf files, and summary

# Warna
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

count=0
apache_count=0
nginx_count=0
declare -A tld_count

echo -e "${CYAN}===== DOMAIN LIST CHECKER REPORT =====${NC}\n"

# --- Apache ---
if [ -d /etc/apache2/sites-enabled ]; then
  for conf in /etc/apache2/sites-enabled/*.conf; do
    [ -e "$conf" ] || continue
    domain=$(grep -i "ServerName" "$conf" | awk '{print $2}' | head -n1)
    root=$(grep -i "DocumentRoot" "$conf" | awk '{print $2}' | head -n1)
    count=$((count+1))
    apache_count=$((apache_count+1))
    tld=$(echo "$domain" | awk -F. '{print $NF}')
    tld_count[$tld]=$((tld_count[$tld]+1))
    echo -e "[${RED}${count}${NC}]-${GREEN}[Apache]${NC} $domain"
    echo -e "   Root: ${YELLOW}$root${NC}"
    echo -e "   Conf: ${CYAN}$conf${NC}\n"
  done
fi

# --- Nginx ---
if [ -d /etc/nginx/sites-enabled ]; then
  for conf in /etc/nginx/sites-enabled/*.conf; do
    [ -e "$conf" ] || continue
    domain=$(grep -i "server_name" "$conf" | awk '{print $2}' | sed 's/;//' | head -n1)
    root=$(grep -i "root " "$conf" | awk '{print $2}' | sed 's/;//' | head -n1)
    count=$((count+1))
    nginx_count=$((nginx_count+1))
    tld=$(echo "$domain" | awk -F. '{print $NF}')
    tld_count[$tld]=$((tld_count[$tld]+1))
    echo -e "[${RED}${count}${NC}]-${GREEN}[Nginx]${NC} $domain"
    echo -e "   Root: ${YELLOW}$root${NC}"
    echo -e "   Conf: ${CYAN}$conf${NC}\n"
  done
fi

# --- Summary ---
echo -e "${CYAN}===== SUMMARY =====${NC}"
echo -e "Total Domains: ${YELLOW}$count${NC}"
echo -e "Apache Domains: ${GREEN}$apache_count${NC}"
echo -e "Nginx Domains: ${GREEN}$nginx_count${NC}\n"

echo -e "${CYAN}TLD Breakdown:${NC}"
for tld in "${!tld_count[@]}"; do
  echo -e "   .${tld}: ${YELLOW}${tld_count[$tld]}${NC}"
done
