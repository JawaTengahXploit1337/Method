#!/bin/bash
# Universal Domain Checker
# Works on Nginx, Apache, LiteSpeed/OpenLiteSpeed across Linux distros

# Warna
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

count=0
apache_count=0
nginx_count=0
litespeed_count=0
declare -A tld_count

echo -e "${CYAN}===== UNIVERSAL DOMAIN CHECKER =====${NC}\n"

scan_configs() {
  local type=$1
  local path=$2
  local server_kw=$3
  local root_kw=$4

  if [ -d "$path" ]; then
    for conf in "$path"/*.conf; do
      [ -e "$conf" ] || continue
      domain=$(grep -i "$server_kw" "$conf" | awk '{print $2}' | sed 's/;//' | head -n1)
      root=$(grep -i "$root_kw" "$conf" | awk '{print $2}' | sed 's/;//' | head -n1)
      [ -z "$domain" ] && continue
      count=$((count+1))
      case $type in
        Apache) apache_count=$((apache_count+1)) ;;
        Nginx) nginx_count=$((nginx_count+1)) ;;
        LiteSpeed) litespeed_count=$((litespeed_count+1)) ;;
      esac
      tld=$(echo "$domain" | awk -F. '{print $NF}')
      tld_count[$tld]=$((tld_count[$tld]+1))
      echo -e "[${RED}${count}${NC}]-${GREEN}[${type}]${NC} $domain"
      echo -e "   Root: ${YELLOW}$root${NC}"
      echo -e "   Conf: ${CYAN}$conf${NC}\n"
    done
  fi
}

# Scan Apache
scan_configs "Apache" "/etc/apache2/sites-enabled" "ServerName" "DocumentRoot"
scan_configs "Apache" "/etc/httpd/conf.d" "ServerName" "DocumentRoot"

# Scan Nginx
scan_configs "Nginx" "/etc/nginx/sites-enabled" "server_name" "root"
scan_configs "Nginx" "/etc/nginx/conf.d" "server_name" "root"

# Scan LiteSpeed / OpenLiteSpeed
scan_configs "LiteSpeed" "/usr/local/lsws/conf/vhosts" "vhDomain" "vhRoot"

# --- Summary ---
echo -e "${CYAN}===== SUMMARY =====${NC}"
echo -e "Total Domains: ${YELLOW}$count${NC}"
echo -e "Apache Domains: ${GREEN}$apache_count${NC}"
echo -e "Nginx Domains: ${GREEN}$nginx_count${NC}"
echo -e "LiteSpeed Domains: ${GREEN}$litespeed_count${NC}\n"

echo -e "${CYAN}TLD Breakdown:${NC}"
for tld in "${!tld_count[@]}"; do
  echo -e "   .${tld}: ${YELLOW}${tld_count[$tld]}${NC}"
done
