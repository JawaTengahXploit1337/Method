#!/bin/bash
# Auto installer Zsh + Oh My Zsh + plugins + bash-style prompt
# Support: Ubuntu/Debian, CentOS/RHEL/AlmaLinux

set -e

echo "🚀 Starting installation..."

# Detect OS family
if [ -f /etc/debian_version ]; then
    echo "Detected Debian/Ubuntu"
    sudo apt update
    sudo apt install -y zsh git curl
elif [ -f /etc/redhat-release ]; then
    echo "Detected RHEL/CentOS/AlmaLinux"
    if command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y zsh git curl
    else
        sudo yum install -y zsh git curl
    fi
else
    echo "❌ Unsupported OS. Please install zsh, git, curl manually."
    exit 1
fi

# Install Oh My Zsh
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    echo "Installing Oh My Zsh..."
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

# Install plugins
echo "Installing plugins..."
git clone https://github.com/zsh-users/zsh-autosuggestions \
    ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions || true

git clone https://github.com/zsh-users/zsh-syntax-highlighting \
    ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting || true

# Update ~/.zshrc
echo "Configuring ~/.zshrc..."
sed -i 's/^plugins=(.*)$/plugins=(git zsh-autosuggestions zsh-syntax-highlighting)/' ~/.zshrc || true

cat << 'EOF' >> ~/.zshrc

# Custom bash-style prompt
PROMPT='%n@%m:%~# '
EOF

# Change default shell to zsh
chsh -s $(which zsh)

echo "✅ Installation complete. Logout/login, then run 'zsh'."
